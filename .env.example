# GEMINI_API_KEY: Gemini API Key for LLM chat and grievance analysis
GEMINI_API_KEY=

# GROQ_API_KEY: REQUIRED. Groq is the single provider for both the LLM answers
# (llama-3.1-8b-instant / llama-3.3-70b-versatile) and speech-to-text
# (whisper-large-v3-turbo, Kannada + Hindi + English). Get one at
# https://console.groq.com/keys
GROQ_API_KEY="gsk_your_working_key_here"

# Voice output needs NO key: the helpline speaks with the free Microsoft Edge
# neural voices (see EDGE TTS notes in server.ts). Optional overrides:
# TTS_EDGE_VOICE_KN="kn-IN-SapnaNeural"
# TTS_EDGE_VOICE_HI="hi-IN-SwaraNeural"
# TTS_EDGE_VOICE_EN="en-IN-NeerjaNeural"


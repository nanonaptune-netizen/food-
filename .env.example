# GEMINI_API_KEY: Gemini API Key for LLM chat and grievance analysis
GEMINI_API_KEY=

# GROQ_API_KEY: REQUIRED. Groq is the single provider for both the LLM answers
# and speech-to-text (whisper-large-v3-turbo, Kannada + Hindi + English).
# Get one at https://console.groq.com/keys
# NEVER commit a real key. This file is a template only.
GROQ_API_KEY="gsk_your_working_key_here"

# Voice output needs NO key: the helpline speaks with the free Microsoft Edge
# neural voices (see EDGE TTS notes in server.ts). Optional overrides:
# TTS_EDGE_VOICE_KN="kn-IN-SapnaNeural"
# TTS_EDGE_VOICE_HI="hi-IN-SwaraNeural"
# TTS_EDGE_VOICE_EN="en-IN-NeerjaNeural"

# TURSO_DATABASE_URL: Turso LibSQL URL
TURSO_DATABASE_URL="libsql://your-database-name.your-org.turso.io"

# TURSO_AUTH_TOKEN: Turso Auth Token
TURSO_AUTH_TOKEN="your_turso_auth_token"

# CLOUDINARY_URL: Cloudinary Connection String (cloudinary://<key>:<secret>@<cloud_name>)
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# ADMIN_PIN: PIN that unlocks the admin dashboard. The server verifies it and
# issues a short-lived session token; the dashboard API refuses every request
# without one. Change this from the default before deploying.
ADMIN_PIN="change-this-admin-pin"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TWILIO_ACCOUNT_SID: Twilio Account SID (starts with AC)
TWILIO_ACCOUNT_SID="AC_YOUR_ACCOUNT_SID"

# TWILIO_API_KEY_SID: Twilio API Key SID (starts with SK)
TWILIO_API_KEY_SID="SK_YOUR_API_KEY_SID"

# TWILIO_API_KEY_SECRET: Twilio API Key Secret
TWILIO_API_KEY_SECRET="YOUR_API_KEY_SECRET"

# TWILIO_PHONE_NUMBER: Twilio Virtual Phone Number
TWILIO_PHONE_NUMBER="+1234567890"
